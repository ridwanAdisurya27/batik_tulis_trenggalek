# ============================================================
#  .env.example — Template variabel lingkungan
#  Proyek  : Batik Tulis Trenggalek / Kage Experience
#  PETUNJUK: Salin file ini menjadi .env, lalu isi nilai-nya.
#            File .env TIDAK boleh di-commit ke Git.
# ============================================================

# ------ Konfigurasi Umum Aplikasi --------------------------
VITE_APP_NAME="Batik Tulis Trenggalek"
VITE_APP_VERSION="1.0.0"
VITE_APP_URL="http://localhost:3000"

# ------ Mode Lingkungan ------------------------------------
VITE_ENV="development"

# ------ API / Backend (isi jika ada integrasi API) ---------
# VITE_API_BASE_URL=""
# VITE_API_KEY=""

# ------ Google Analytics (opsional) -----------------------
# VITE_GA_MEASUREMENT_ID=""

# ------ Firebase (opsional) --------------------------------
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

# ------ Fitur Toggle (opsional) ---------------------------
# VITE_ENABLE_DEBUG="false"
# VITE_SHOW_DEV_TOOLS="false"
